# ─────────────────────────────────────────────────────────
# Derma6 v2  –  Environment Variables
# Copy this file to .env and fill in the values marked *.
# Never commit .env to git.
# ─────────────────────────────────────────────────────────

# ── LLM (required *) ─────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model to use for the agent. Any OpenRouter-supported model works.
# Cheaper / faster alternatives: openai/gpt-4o-mini, google/gemini-flash-1.5
LLM_MODEL=openai/gpt-4o-mini
# Vision model used for skin analysis image uploads (must support vision on OpenRouter).
VISION_MODEL=openai/gpt-4o
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Embeddings ────────────────────────────────────────────
# Served via OpenRouter — same API key, no extra setup.
# qwen3-embedding-8b gives the best retrieval quality for this KB size.
EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# ── Auth (required *) ─────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Must be long and random. Never reuse across environments.
SECRET_KEY=

# JWT lifetime in minutes. 1440 = 24 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Supabase Auth (required *) ────────────────────────────
# Project URL (Project Settings → API → Project URL).
SUPABASE_URL=https://[project-ref].supabase.co
# Optional override — derived from SUPABASE_URL when left blank:
# f"{SUPABASE_URL}/auth/v1/.well-known/jwks.json"
SUPABASE_JWKS_URL=
# Shared-secret HS256 fallback (Project Settings → API → JWT Secret).
# Only needed if the project is not using JWKS-based (RS256/ES256) signing.
SUPABASE_JWT_SECRET=

# ── Storage ───────────────────────────────────────────────
# Postgres connection string from Supabase (Project Settings → Database →
# Connection string → URI). Three options, and the choice has bitten us before:
#
#   • Transaction pooler — pooler.supabase.com:6543 — DEFAULT, and what the line
#     below shows. Highest client limit. Cannot support prepared statements, so
#     the app disables them automatically when it sees port 6543 (see
#     Settings.db_uses_transaction_pooler). Nothing else to configure.
#   • Session pooler — pooler.supabase.com:5432 — caps the WHOLE project at 15
#     client connections and took prod down on 2026-07-15 once normal traffic
#     needed more than that. Avoid unless you need prepared statements.
#   • Direct — db.[project-ref].supabase.co:5432 — highest limits and full
#     Postgres, but IPv6-only for newer projects, which is why prod is on a
#     pooler at all.
#
# For local dev without Supabase, a sqlite:/// URL also works (used by tests).
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
CHROMA_PERSIST_DIR=./data/chroma
CONFLICT_TABLE_PATH=./knowledge_base/conflict_table.json

# ── Retrieval ─────────────────────────────────────────────
# TOP_K: how many KB chunks to retrieve per query (4 is a good default).
# MIN_SCORE: minimum cosine similarity to include a result (0 = keep all).
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.3

# ── Agentic RAG fallback (optional) ────────────────────────
# Strategy when CRAG grading finds retrieved docs irrelevant: "llm-only"
# (default, no external call) or "web-search" (tries Tavily, then DuckDuckGo).
CRAG_FALLBACK_STRATEGY=llm-only
# Only used when CRAG_FALLBACK_STRATEGY=web-search. Get a key at
# https://tavily.com — leave blank to fall back to DuckDuckGo (no key needed).
TAVILY_API_KEY=

# ── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# ── Input validation ──────────────────────────────────────
MAX_MESSAGE_CHARS=2000

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ── Sentry error monitoring (optional) ───────────────────
# Leave blank to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── LangSmith tracing (optional) ─────────────────────────
# Set LANGSMITH_API_KEY to enable. Leave blank to disable.
# EU endpoint: https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=derma6
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
