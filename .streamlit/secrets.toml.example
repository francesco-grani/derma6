# Copy this file to .streamlit/secrets.toml for local use,
# or paste the key-value pairs into the Streamlit Cloud secrets editor.

# Required
OPENROUTER_API_KEY = "sk-or-..."

# Optional — override defaults for Streamlit Cloud's ephemeral filesystem
SQLITE_DB_PATH    = "/tmp/skincare.db"
CHROMA_PERSIST_DIR = "/tmp/chroma"
LOG_FILE           = "/tmp/logs/app.log"

# Optional — model overrides
# LLM_MODEL        = "openai/gpt-4o-mini"
# EMBEDDING_MODEL  = "qwen/qwen3-embedding-8b"
