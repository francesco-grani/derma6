# Replace YOUR_IP with your Hetzner server IP (e.g. 1-2-3-4.sslip.io)
YOUR_IP.sslip.io {
    # Proxy API requests to FastAPI backend
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Serve React frontend static files
    handle {
        root * /srv/www
        try_files {path} /index.html
        file_server
    }
}
