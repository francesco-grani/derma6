{
  "name": "deepsec-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "deepsec scanning workspace",
  "type": "module",
  "workspaces": [],
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "process:openrouter": "deepsec process --agent pi --model openrouter/openai/gpt-5.4 --ai-api-key-env OPENROUTER_API_KEY",
    "revalidate:openrouter": "deepsec revalidate --agent pi --model openrouter/openai/gpt-5.4 --ai-api-key-env OPENROUTER_API_KEY"
  },
  "dependencies": {
    "deepsec": "^2.2.0"
  }
}
